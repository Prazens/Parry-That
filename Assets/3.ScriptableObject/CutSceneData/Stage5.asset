  m_Script: {fileID: 11500000, guid: 030148ca4f1b0e6419176c7fa6452b9d, type: 3}
  m_Name: Stage5
  m_EditorClassIdentifier: 
  stageId: 5
  category: 0
  textSet:
  - "(\uC624\uB298\uB3C4 \uACF5\uC5F0\uC911)"
  - "\uC640\uC544\uC544\uC544\uC544\uC559\uC544\u314F\uC544\uC544 \uB9C8\uC655\uB2D8
    \uC0AC\uB791\uD574\uC694"
  - ....
  - "(\uD604\uD0C0)...\uC774\uB807\uAC8C\uAE4C\uC9C0 \uBA39\uACE0\uC0B4\uC544\uC57C
    \uD560\uAE4C?"
  - "\uC5B4\uC774 \uB9C8\uC655! \uC774\uBC88\uB2EC \uC815\uC0B0\uC774\uB2E4!"
  - "(\uB9C9\uB300\uD55C \uB3C8)"
  - "\uADF8\uB798. \uC774 \uC815\uB3C4\uBA74 \uCDA4\uCD94\uACE0 \uB178\uB798\uD560
    \uB9CC\uB3C4 \uD558\uC9C0."
  - "\uC774\uAC8C \uC74C\uC545\uC758 \uD798 \uC544\uB2C8\uACA0\uC5B4? \uC774 \uC88B\uC740
    \uAC78 \uC5C6\uC560\uB824 \uD588\uB2E4\uACE0?"
  - "\uADF8\uB7EC\uB2C8\uAE4C! \uB0B4\uAC00 \uBBF8\uCCE4\uC5C8\uB098 \uBD10! \uD558\uD558\uD558!"
  - "(\uB9C8\uC655 \uB0A9@\uCE58)"
  - "\uC73C..\uAC11\uC790\uAE30 \uBB34\uC2A8 \uC77C\uC774\uC9C0?"
  - "\uB0A0 \uAE30\uC5B5\uD558\uB098? \uB108\uC5D0\uAC8C \uC18C\uB9AC\uB97C \uC5C6\uC568
    \uAD8C\uB2A5\uC744 \uC900 \uC2E0, \uBBA4\uD2B8\uB2E4."
  - "\uB204\uAD6C\uC138\uC694?"
  - "\uB3C8\uC5D0 \uC808\uC5EC\uC838\uC11C \uB2E4 \uC78A\uC5B4\uBC84\uB838\uB2E8
    \uB9D0\uC774\uB0D0! \uC18C\uB9AC\uB97C \uC5C6\uC560\uACA0\uB2E4\uACE0 \uB098\uC640
    \uC57D\uC18D\uD558\uC9C0 \uC54A\uC558\uB354\uB0D0?"
  - "\uADF8\uB550 \uADF8\uB7AC\uC9C0\uB9CC.. \uC9C0\uAE08\uC740 \uC74C\uC545\uC774
    \uC81C \uBC25\uC904\uC778\uAC78\uC694? "
  - "\uB2E5\uCCD0\uB77C! \uB0B4 \uB9D0\uC744 \uB4E4\uC744 \uB54C\uAE4C\uC9C0 \uBC31\uC0C9\uC18C\uC74C
    \uACE0\uBB38\uC744 \uD558\uACA0\uB2E4!"
  - "\uBB34\uC2A8 \uC77C\uC774 \uBC8C\uC5B4\uC9C0\uACE0 \uC788\uB294 \uAC78\uAE4C?"
  - "\uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4. \uB0A9\uCE58\uB77C\uB3C4 \uB2F9\uD55C
    \uAC78\uAE4C\uC694?"
  - "\uC0B4\uB824\uC918!!! \uB098 \uB0A9\uCE58\uB2F9\uD558\uACE0 \uACE0\uBB38\uB2F9\uD558\uC73C\uC544\uC544\uC545"
  - "\uB9C8\uB07C\uC57C\uC544\uC544\uC544\uC545! (\uD638\uB85C\uB85D)"
  - "\uC548\uB3FC!!!!! \uC6B0\uB9AC \uBC25\uC904\uC774!!!! \uC5B4\uB5A1\uD558\uC9C0?"
  - "\uBE68\uB9AC \uAD6C\uD558\uB7EC \uAC00\uC2DC\uC8E0!!!! \uC800\uAC74 \uBD84\uBA85
    \uCE68\uBB35\uC758 \uC2E0\uC785\uB2C8\uB2E4! \uC81C\uAC00 \uC704\uCE58\uB97C
    \uC555\uB2C8\uB2E4!"
  - "\uACFC\uC5F0\uC18C\uB9AC\uC640\uC815\uB839\uC740\uB9C8\uC655\uC744\uAD6C\uD574\uB0BC\uC218\uC787\uC744\uAC83\uC778\uAC00\uADF8\uAC83\uC740\uB2F9\uC2E0\uC758\uCEE8\uD2B8\uB864\uC5D0\uB2EC\uB837\uB2E4..."
