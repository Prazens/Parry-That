  m_Script: {fileID: 11500000, guid: 030148ca4f1b0e6419176c7fa6452b9d, type: 3}
  m_Name: Stage7
  m_EditorClassIdentifier: 
  stageId: 7
  category: 0
  textSet:
  - "\uC774 \uC815\uB3C4 \uACE0\uBB38\uD588\uC73C\uBA74 \uC18C\uB9AC\uB97C \uD3EC\uAE30\uD558\uACA0\uB2E4\uACE0
    \uD560 \uB9CC\uB3C4 \uD55C\uB370..."
  - "\uC544\uB2C8! \uB09C \uC808\uB300 \uD3EC\uAE30\uD558\uC9C0 \uC54A\uC544!!"
  - "\uC2DC\uB044\uB7FD\uAE30\uB9CC \uD55C \uC18C\uB9AC\uBA70, \uC74C\uC545\uC774\uBA70...
    \uB3C4\uB300\uCCB4 \uADF8\uAC8C \uC65C \uC911\uC694\uD55C \uAC8C\uB0D0!"
  - "\uC74C\uC545\uC740 \uB3C8\uC774 \uB418\uB2C8\uAE50!!!!!!!!"
  - "\uC544...\uADF8\uAC70 \uB54C\uBB38\uC774\uC57C?"
  - "\uB098 \uB3C8 \uB9CE\uC740\uB370, \uC774 \uC815\uB3C4 \uAE08\uC561 \uC77C\uC2DC\uBD88\uC774\uBA74
    \uD3EC\uAE30\uD560\uB798?"
  - "\uADF8...\uADF8 \uC815\uB3C4 \uC131\uC758\uB77C\uBA74 \uAE30\uAEBC\uC774...<br>\uC5B4\uB77C?"
  - "(\uB450\uB465)"
  - "\uB098\uD0C0\uB0AC\uAD6C\uB098, \uBC29\uD574\uAFBC \uC790\uC2DD. \uB9C8\uC655\uC740
    \uC774\uBBF8 \uB0B4 \uC790\uBCF8\uB825\uC5D0 \uB118\uC5B4\uC654\uB290\uB2C8\uB77C."
  - "\uB9C8\uC655\uC544! \uC800 \uC815\uB3C4 \uB3C8\uC740 3\uB144\uC774\uBA74 \uBC8C\uAC70\uB4E0?!
    \uC7A5\uAE30\uC801 \uC218\uC775\uC744 \uC0DD\uAC01\uD574!"
  - "\uC77C\uB9D0\uC758 \uC124\uB4DD\uB825\uB3C4 \uC5C6\uB294 \uADA4\uBCC0\uC774\uB85C\uAD6C\uB098!
    \uBD88\uB85C\uC18C\uB4DD\uC774 \uD0D0\uB098\uC9C0 \uC54A\uB290\uB0D0?"
  - "\uBB50\uB798! \uB9C8\uC655 \uB0B4\uB194\uB77C \uC774 \uC7A1\uADC0\uC57C!"
  - "\uACC4\uC57D\uC740 \uB098\uB791 \uD588\uB2E8 \uB9D0\uC774\uB2E4, \uBC29\uD574\uAFBC\uC544!!"
  - "\uADF8\uB7EC\uB2E4 \uB04A\uC5B4\uC9C0\uACA0\uC2B5\uB2C8\uB2E4! \uADF8\uB0E5
    \uD55C \uD310 \uB5A0\uC11C \uC774\uAE34 \uCABD \uB9D8\uB300\uB85C \uD558\uC8E0?"
  - "\uBBA4\uD2B8\uAC00 \uC774\uAE30\uBA74 \uC804 \uC138\uACC4\uB294 \uCE68\uBB35\uC5D0
    \uBB3C\uB4E4\uAC8C \uB418\uACA0\uC8E0!"
  - "\uBC18\uBA74 \uC6A9\uC0AC\uB2D8\uC774 \uC774\uAE30\uBA74 \uB9C8\uC655\uC744
    \uB370\uB824\uC624\uACE0! \uBBA4\uD2B8\uC758 \uAE08\uACE0\uB3C4 \uC2F9 \uD138\uC5B4\uAC00\uB294
    \uAC81\uB2C8\uB2E4!"
  - "\uC544\uB2C8, \uB0B4 \uAE08\uACE0\uB294 \uC65C... "
  - "\uADF8\uB798 \uC88B\uB2E4! \uAE30\uC2B5\uC2A4\uB9E4\uC26C!"
  - "\uC544\uB2C8 \uC7A0\uAE50\uB9CC!! "
  - "\uB364\uBCBC\uB77C!!!!!!!!!!!!!!!"
  - "\uC138\uACC4\uC758\uC6B4\uBA85\uC774\uB2F9\uC2E0\uC758\uC190\uAC00\uB77D\uC5D0\uB2EC\uB837\uB2E4
    \uACFC\uC5F0 \uC5B5\uB355\uACC4\uB420\uAC83\uC778\uAC00...."
