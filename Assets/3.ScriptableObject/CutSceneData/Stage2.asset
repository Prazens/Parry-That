  category: 0
  textSet:
  - "\uC81C \uAE30\uC5B5\uC774 \uB9DE\uB2E4\uBA74 \uC5EC\uAE30\uAC00 \uB9C8\uC655\uC758
    \uADFC\uAC70\uC9C0\uC785\uB2C8\uB2E4!"
  - "\uBC8C\uC368 \uC654\uB2E4\uACE0? \uB9C8\uC655\uCE58\uACE0 \uB108\uBB34 \uD5C8\uC220\uD55C
    \uAC70 \uC544\uB0D0?"
  - "\uB9C8\uC655\uC774 \uD504\uB85C\uC81D\uD2B8\uB97C \uC544\uC8FC \uCD09\uBC15\uD558\uAC8C
    \uC9C4\uD589\uD574\uC11C \uADF8\uB807\uC2B5\uB2C8\uB2E4."
  - "\uB098\uC640\uB77C \uB9C8\uC655!"
  - ".\uBB50\uC57C. \uC65C \uB108\uB124\uB4E4\uBC16\uC5D0 \uC5C6\uC5B4?"
  - "\uB9C8\uC655\uB2D8\uC740 \uC6B0\uB9AC\uB97C \uBC84\uB9AC\uACE0 \uD53C\uB09C
    \uAC00\uC168\uB2E4!!!!!"
  - "\uC548\uC804\uD55C \uACF3\uC5D0\uC11C \uB354\uC6B1 \uC644\uBCBD\uD55C \uACC4\uD68D\uC744
    \uC138\uC6B0\uACE0 \uACC4\uC2E0\uB2E4!!!!!"
  - "\uC544\uBB34\uB798\uB3C4 \uB9C8\uC655\uC774 \uC598\uB124\uB97C \uBC29\uD328\uB85C
    \uB450\uACE0 \uB3C4\uB9DD\uAC14\uB098 \uBD05\uB2C8\uB2E4. \uC5B4\uCA50\uC9C0
    \uC27D\uAC8C \uB05D\uB09C\uB2E4 \uD588\uC5B4."
  - "\uC790\uC790, \uB124\uBAA8\uBA38\uB9AC \uC5EC\uB7EC\uBD84! \uB09C \uC5EC\uB7EC\uBD84\uC744
    \uD574\uCE58\uB7EC \uC628 \uAC8C \uC544\uB2D9\uB2C8\uB2E4! \uBCF8\uB798\uC758
    \uADC0\uC5EC\uC6B4 \uBAA8\uC2B5\uC73C\uB85C \uB3CC\uB824 \uB4DC\uB9B4\uAC8C\uC694!"
  - "\uC9E0! \uBC14\uB85C \uC774\uB7F0 \uACE0\uC591\uC774\uAC00 \uB2F9\uC2E0\uB4E4\uC758
    \uBCF8\uB798...\n........"
  - ......
  - "\uC800\uB188\uB4E4\uC774 \uC6B0\uB9AC\uB97C \uD574\uCE58\uB7EC \uC654\uB2E4!!!!!!!"
  - "....\uC774\uB7F0."
