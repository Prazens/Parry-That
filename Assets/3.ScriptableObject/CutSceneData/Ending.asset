  m_Script: {fileID: 11500000, guid: 030148ca4f1b0e6419176c7fa6452b9d, type: 3}
  m_Name: Ending
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneData
  textSet:
  - "\uB9C8\uC655\uC774 \uC4F0\uB7EC\uC84C\uB2E4! \uC6A9\uC0AC\uB2D8 \uAD49\uC7A5\uD558\uC2ED\uB2C8\uB2E4!"
  - "\uB610 \uD070\uC18C\uB9AC\uCCD0 \uBD10\uB77C \uB9C8\uC655! (\uCFE8\uB7ED) \uB204\uAC00
    \uB204\uAD74 \uC8FD\uC778\uB2E4\uACE0?!"
  - "\uB098\uD55C\uD14C \uC65C \uC774\uB798! \uC18C\uB9AC \uC880 \uC5C6\uC564\uB2E4\uB294
    \uAC8C \uADF8\uB807\uAC8C \uD070\uC77C\uC774\uC57C??"
  - "\uB108. \uC18C\uB9AC \uB54C\uBB38\uC5D0 \uC2DC\uD5D8\uC744 \uB9DD\uCCE4\uB2E4\uACE0
    \uADF8\uB7AC\uC9C0?"
  - "\uADF8...\uADF8\uB798."
  - "\uB098\uB294 \uB124\uAC00 \uC18C\uB9AC\uB97C \uC5C6\uC560\uC11C \uC54C\uB78C\uC744
    \uBABB \uB4E4\uC5C8\uAE30 \uB54C\uBB38\uC5D0 \uC2DC\uD5D8\uC744 \uB9DD\uCCE4\uB2E8
    \uB9D0\uC774\uB2E4!"
  - '!!'
  - "\uADF8\uB807\uB2E4\uACE0 \uB0B4\uAC00 \uC138\uC0C1 \uBAA8\uB4E0 \uC2DC\uD5D8\uC744
    \uC5C6\uC560\uACA0\uB2E4\uB294 \uADF9\uB2E8\uC801\uC778 \uB9DD\uC0C1\uC744 \uD558\uC9C4
    \uC54A\uC558\uC5B4!"
  - "\uB09C \uB108 \uAC19\uC740 \uC815\uC2E0 \uB098\uAC04 \uCACC\uC0DD\uC774\uAC00
    \uC544\uB2C8\uAC70\uB4E0!"
  - "...\uB0B4\uAC00 \uC8FD\uC744 \uC8C4\uB97C \uC9C0\uC5C8\uC5B4. \uC5B4\uB5BB\uAC8C
    \uC18D\uC8C4\uD574\uC57C \uD560\uAE4C?"
  - "\uC18D\uC8C4\uB77C... \uBC29\uBC95\uC774 \uD558\uB098 \uC788\uAE34 \uD558\uC9C0."
  - "\uB10C \uC18C\uB9AC\uB97C \uC5C6\uC560\uB294 \uC8C4\uB97C \uC9C0\uC5C8\uC73C\uB2C8,
    \uC18C\uB9AC\uB85C \uAC1A\uC544\uC57C\uACA0\uC9C0?"
  - "\uADF8\uAC8C \uBB34\uC2A8 \uC18C\uB9AC\uC57C?"
  - "\uC544\uC774\uB3CC \uAC00\uC218\uB97C \uD574\uB77C!!!!!!!!!"
  - "\uC608???????????"
  - "\uADF8\uB807\uAC8C \uC18C\uB9AC\uB294 \uB9C8\uC655\uC744 \uC544\uC774\uB3CC\uB85C
    \uB9CC\uB4E4\uACE0 \uC790\uC2E0\uC740 \uD504\uB85C\uB4C0\uC11C\uAC00 \uB418\uC5B4
    \uB5BC\uB3C8\uC744 \uBC8C\uC5C8\uC2B5\uB2C8\uB2E4!"
  - "\uC5ED\uC2DC \uC2DC\uD5D8 \uB530\uC704 \uC548 \uBCF8\uB2E4\uACE0 \uC778\uC0DD\uC774
    \uB9DD\uD558\uB294 \uBC95\uC740 \uC5C6\uB294 \uAC70\uB85C\uAD70\uC694."
  - '                             '
