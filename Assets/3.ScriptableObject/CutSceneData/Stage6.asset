  m_Script: {fileID: 11500000, guid: 030148ca4f1b0e6419176c7fa6452b9d, type: 3}
  m_Name: Stage6
  m_EditorClassIdentifier: 
  stageId: 6
  category: 0
  textSet:
  - "\uC790, \uC774\uC81C\uBD80\uD130 \uC194\uC9C1\uD788 \uB300\uB2F5\uD574\uC57C
    \uD560 \uAC70\uC57C."
  - "\uBB3C\uB860\uC785\uB2C8\uB2E4! \uC0B4\uB824\uB9CC \uC8FC\uC2ED\uC1FC!"
  - "\uBBA4\uD2B8\uB294 \uB9C8\uC655\uC744 \uC65C \uC7A1\uC544\uAC14\uC9C0?"
  - "\uB9C8\uC655\uC5D0\uAC8C \uD798\uC744 \uC8FC\uC2E0 \uAC8C \uBBA4\uD2B8 \uB2D8\uC785\uB2C8\uB2E4.
    \uCE68\uBB35\uC740\uCEE4\uB155 \uC74C\uC545\uC73C\uB85C \uBA39\uACE0\uC0B4\uAE30\uC5D0
    \uBC8C\uC744 \uB0B4\uB9AC\uC2DC\uB824\uB294"
  - "\uB9C8\uC655\uC774 \uACC4\uC57D \uC704\uBC18\uC744 \uD558\uAE34 \uD588\uB124\uC694.
    \uC815\uB2F9\uC131\uC740 \uC800\uCABD\uC5D0 \uC788\uB294 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  - "\uD760....."
  - "\uADF8\uB807\uC9C0 \uC54A\uB2E4! \uC624\uD788\uB824 \uB9C8\uC655\uC740 \uC18C\uB9AC\uB97C
    \uC5C6\uC560\uB294 \uB370 \uACF5\uD5CC\uD588\uB2E4\uACE0!"
  - "\uB9C8\uC655\uC758 \uC778\uAE30\uAC00 \uC555\uB3C4\uC801\uC774\uB77C\uC11C \uC218\uB9CE\uC740
    \uBBA4\uC9C0\uC158\uB4E4\uC774 \uC740\uD1F4 \uBC0F \uC544\uC0AC\uD588\uB2E4! "
  - "\uACB0\uACFC\uC801\uC73C\uB85C \uC74C\uC545\uC758 \uC591\uC774 \uC904\uC5B4\uB4E4\uAC8C
    \uB41C \uAC70\uC9C0!"
  - "\uADF8...\uADF8\uB7F0\uAC00?"
  - "\uADF8...\uADF8\uB807\uC9C0!"
  - "\uC6A9\uC0AC\uB2D8! \uC720\uB839\uC774 \uB354 \uBAB0\uB824\uC635\uB2C8\uB2E4!\r\n\uC800\uD76C
    \uB54C\uBB38\uC5D0 \uAD76\uC5B4\uC8FD\uC740 \uBBA4\uC9C0\uC158\uB4E4\uC774 \uC720\uB839\uC774
    \uB410\uB098 \uBD05\uB2C8\uB2E4!"
  - "\uC800\uB188\uB4E4 \uB54C\uBB38\uC5D0 \uC6B0\uB9AC\uAC00 \uAD76\uC5B4\uC8FD\uC5C8\uAD6C\uB098!
    \uBCF5\uC218\uD558\uACA0\uB2E4!!!"
  - "\uC544...\uB610 \uC2DC\uC791\uC774\uB124."
