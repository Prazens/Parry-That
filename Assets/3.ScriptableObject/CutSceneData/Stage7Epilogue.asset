  m_Name: Stage7Epilogue
  m_EditorClassIdentifier: 
  stageId: 7
  category: 1
  textSet:
  - "\uC774 \uBE44\uAC81\uD55C \uC545\uB2F9\uB4E4\uC544! \uAE30\uC2B5\uD558\uACE0
    \uB098\uC11C \uC2DC\uC791\uD558\uB294 \uAC8C \uC5B4\uB528\uB0D0!"
  - "\uB124 \uBAA9\uC801\uC744 \uC0DD\uAC01\uD558\uBA74 \uC5B4\uCC28\uD53C \uB2C8\uAC00
    \uC545\uB2F9\uC774\uAC70\uB4E0? "
  - "\uC790 \uADF8\uB7FC \uAE08\uACE0\uB97C \uD138\uC5B4 \uBCFC\uAE4C?"
  - "\uC7A0\uAE50\uB9CC\uC694! \uD55C \uBC88\uB9CC \uBD10\uC8FC\uC138\uC694! \uADF8\uAC70
    \uB0B4 \uC804 \uC7AC\uC0B0\uC774\uB780 \uB9D0\uC774\uC57C!!"
  - "\uC18C\uB9AC\uB3C4 \uC548 \uC5C6\uC568\uAC8C\uC694! \uC120\uC0DD\uB2D8 \uC81C\uBC1C\uC694!!!"
  - "\uC74C....."
  - "\uC57D\uAC04 \uBD88\uC30D\uD558\uAE30\uB3C4 \uD55C\uB370\uC694... \uADF8\uB0E5
    \uC801\uB2F9\uD788 \uCC59\uAE30\uB294 \uAC74 \uC5B4\uB5BB\uACA0\uC2B5\uB2C8\uAE4C?"
  - "\uD760\u2026\uC695\uC2EC\uC774 \uACFC\uD558\uBA74 \uC548 \uC88B\uAE34 \uD574.
    \uADF8\uB7FC \uB531 \uC774\uAC83\uB9CC \uCC59\uACA8\uAC00\uC790!"
  - "(\uBC88\uCA4D)"
  - "\uB044\uC544\uC545\u2026\uC774..\uC774\uAC8C \uB300\uCCB4 \uBB50\uC57C?"
  - "\uC5ED\uC2DC \uC778\uAC04\uB4E4\uC740 \uC695\uC2EC\uC774 \uB05D\uC774 \uC5C6\uAD70.
    \uB0B4 \uC608\uC0C1\uC744 \uC804\uD600 \uBC97\uC5B4\uB098\uC9C8 \uC54A\uC544."
  - "\uB0B4 \uCD5C\uB300\uC758 \uAC78\uB9BC\uB3CC\uC740 \uBC14\uB85C \uB108\uC600\uC5B4.
    \uB9C8\uC655\uC740 \uB110 \uC720\uC778\uD558\uAE30 \uC704\uD55C \uBBF8\uB07C\uC600\uC744
    \uBFD0\uC774\uC9C0."
  - "\uC774\uC81C \uB10C \uC601\uC6D0\uD788 \uCE68\uBB35\uD558\uB294 \uB3CC\uC774
    \uB418\uC5B4, \uC18C\uB9AC \uC5C6\uB294 \uC138\uC0C1\uC744 \uBC14\uB77C\uBCF4\uAC70\uB77C."
  - "\uC548\u3137...."
  - "\uB084\uB084\uB084\uB084\uAE54\uAE54\uAE54\uAE54 \uBBA4\uD558\uD558\uD558\uD638\uD638\uD638~~~~"
  - "(\uC774\uB300\uB85C \uC18C\uB9AC\uAC00 \uC5C6\uC5B4\uC9C0\uBA74... \uB09C \uBB50\uD574\uBA39\uACE0
    \uC0B4\uC9C0?)"
  - "(\uB2E4\uC2DC \uACE0\uC2DC\uC0DD \uC2DC\uC808\uB85C? \uADF8\uAC83\uB9CC\uC740....)"
  - ....!
  - "(\uB450\uB465)"
  - 
