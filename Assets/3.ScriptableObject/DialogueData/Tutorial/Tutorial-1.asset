  lines:
  - speakerTag: 2
    expressionTag: 1
    text: "\uC798\uD558\uC168\uC2B5\uB2C8\uB2E4! "
    textRevealDuration: 1
    waitAfterReveal: 2
    waitBeforeReveal: 0
    speakerNameOverride: 
  - speakerTag: 2
    expressionTag: 1
    text: "\uD328\uB9C1\uC73C\uB85C \uC800 \uB140\uC11D\uB4E4\uC740 \uCE58\uC720\uAC00
      \uB420 \uAC81\uB2C8\uB2E4!"
    textRevealDuration: 1.5
    waitAfterReveal: 2
    waitBeforeReveal: 0
    speakerNameOverride: 
  - speakerTag: 1
    expressionTag: 0
    text: "\uACF5\uACA9\uC744 \uBC1B\uC544\uCE58\uBA74 \uC7E4\uB124\uAC00 \uB2E4\uCE58\uB294
      \uAC70 \uC544\uB2C8\uC57C?"
    textRevealDuration: 1.5
    waitAfterReveal: 2
    waitBeforeReveal: 1
    speakerNameOverride: 
  - speakerTag: 2
    expressionTag: 0
    text: "\uC880 \uB9DE\uC544\uC57C \uC815\uC2E0\uC744 \uCC28\uB9AC\uC9C0 \uC54A\uC744\uAE4C\uC694?"
    textRevealDuration: 1.5
    waitAfterReveal: 2
    waitBeforeReveal: 1
    speakerNameOverride: 
  - speakerTag: 1
    expressionTag: 0
    text: "\uADF8\uB7F0\uAC00..??"
    textRevealDuration: 1.5
    waitAfterReveal: 2
    waitBeforeReveal: 1
    speakerNameOverride: 
  - speakerTag: 2
    expressionTag: 0
    text: "\uC544\uBB34\uD2BC, \uC774\uC81C \uB354 \uAC15\uD55C \uACF5\uACA9\uC774
      \uC62C\uD14C\uB2C8"
    textRevealDuration: 1.5
    waitAfterReveal: 2
    waitBeforeReveal: 1
    speakerNameOverride: 
  - speakerTag: 2
    expressionTag: 0
    text: "\uC6A9\uC0AC\uB2D8\uBD80\uD130 \uAC71\uC815\uD558\uC138\uC694!"
    textRevealDuration: 1.2
    waitAfterReveal: 2
    waitBeforeReveal: 0
    speakerNameOverride: 
  - speakerTag: 2
    expressionTag: 0
    text: "<color=#C54646>\uBE68\uAC04\uC0C9 \uACF5\uACA9</color>\uC740 <color=#C54646>\uADF8
      \uBC29\uD5A5\uC73C\uB85C \uC2A4\uC640\uC774\uD504</color>\uD574\uC11C \uBC1B\uC544\uCCD0\uC57C
