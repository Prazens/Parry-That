  m_Script: {fileID: 11500000, guid: 030148ca4f1b0e6419176c7fa6452b9d, type: 3}
  m_Name: Stage3
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneData
  textSet:
  - "\uC544\uC774\uACE0.. \uC774\uC81C \uB2E4 \uD574\uCE58\uC6E0\uB098?"
  - "\uC57C. \uB9C8\uC655 \uC5B4\uB514\uB85C \uAC14\uC5B4? \uC548 \uB9D0\uD574 \uC8FC\uBA74
    \uACE0\uC591\uC774 \uBC25\uC73C\uB85C \uC904 \uAC70\uC57C."
  - "\uB9C8\uC655\uB2D8\uC740 \uACE7 \uC544\uBB34\uB3C4 \uCC3E\uC744 \uC218 \uC5C6\uB294
    \uACF3\uC73C\uB85C \uAC08 \uAC83\uC774\uB2E4! \uB9CC\uB098\uB824\uBA74 \uC11C\uB458\uB7EC\uC57C
    \uD560 \uAC83\uC774\uC57C! \uC8FC\uC18C\uB294..."
  - "\uC88B\uC544. \uBE68\uB9AC \uAC00\uC790!\n                \n\uC6A9\uC0AC\uB2D8!"
  - "\uC774 \uBB3C\uBC94\uB4E4.. \uC544\uC9C1 \uC815\uD654\uAC00 \uC548 \uB410\uC2B5\uB2C8\uB2E4.
    \uB9C8\uBB34\uB9AC\uB97C \uC9C0\uC5B4 \uC918\uC57C \uD558\uC9C0 \uC54A\uC744\uAE4C\uC694?"
  - "\uD558\uC9C0\uB9CC \uADF8\uB7EC\uBA74 \uB9C8\uC655\uC744 \uB193\uCE60\uC9C0\uB3C4
    \uBAA8\uB974\uB294\uB370.."
  - "\uC6A9\uC0AC\uB2D8! \uC598\uB124\uB4E4\uC740 \uC81C\uAC00 \uACB0\uD63C\uC2DD
    \uC8FC\uB840\uAE4C\uC9C0 \uC11C \uC900 \uAC01\uBCC4\uD55C \uC0AC\uC774\uC785\uB2C8\uB2E4!
    \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4!!"
  - "\uD558.. \uC5B4\uCA54 \uC218 \uC5C6\uC9C0."
  - "\uB098\uC911\uC5D0 \uB9C8\uC655 \uB193\uCE58\uBA74 \uCC45\uC784\uC740 \uB108\uD76C\uAC00
    \uC838\uB77C."
