  m_Name: Prologue
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneData
  textSet:
  - "\uB300\uD559\uC0DD '\uC18C\uB9AC'\uB294 \uC2DC\uD5D8\uC744 \uC55E\uB450\uACE0
    \uD314\uC790 \uC88B\uAC8C \uC790\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
  - " \uC2EC\uC9C0\uC5B4 \uAFC8\uAE4C\uC9C0 \uAFB8\uACE0 \uC788\uB124\uC694."
  - "\uC6A9\uC0AC '\uC18C\uB9AC'\uC2DC\uC5EC, \uC138\uACC4\uB97C \uAD6C\uD574\uC8FC\uC18C\uC11C!!"
  - "\uB9C8\uC655\uC774 \uC18C\uB9AC\uC758 \uC815\uB839\uB4E4\uC744 \uD0C0\uB77D\uC2DC\uCF1C
    \uC790\uAE30 \uBD80\uD558\uB85C \uBC14\uAFB8\uACE0 \uC788\uC2B5\uB2C8\uB2E4!"
  - "\uC9C0\uAE08 \uB9C8\uC655\uC744 \uBA48\uCD94\uC9C0 \uBABB\uD558\uBA74 \uC138\uC0C1\uC5D0
    \uC18C\uB9AC\uAC00 \uC5C6\uC5B4\uC838 \uBC84\uB9B4 \uAC81\uB2C8\uB2E4!"
  - "\"\uBBF8\uC548\uD55C\uB370 \uAFC8\uC778 \uAC70 \uB2E4 \uD2F0\uB09C\uB2E4.\""
  - "'\uC18C\uB9AC'\uB294 9\uC2DC\uC5D0 \uC2DC\uD5D8\uC774 \uC788\uC5C8\uC73C\uBBC0\uB85C,
    \uAFC8 \uAFC0 \uC2DC\uAC04\uB530\uC704 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
  - "\uADF8\uB7EC\uB098 \uC9DC\uC794\n                                     \n\"\uC544\""
  - "\"\uC544\uB2C8, \uC54C\uB78C\uC774 \uBD84\uBA85 \uC6B8\uB838\uC5B4\uC57C\uD588\uB294\uB370...?\"\n                                    
    \n\n\"\uC544?\""
  - "\uC8FD\uC5EC\uBC84\uB9AC\uACA0\uB2E4 \uB9C8\uC655!!!!"
